# ============================================================
# Google OAuth (للمدير - Admin Login)
# من: https://console.cloud.google.com/apis/credentials
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================
# Google Service Account (للوصول لـ Google Calendar)
# من: https://console.cloud.google.com/iam-admin/serviceaccounts
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# نطاق Google Workspace الخاص بك (مثال: company.com)
GOOGLE_WORKSPACE_DOMAIN=your-company.com

# بريد مدير Google Workspace (للـ impersonation)
GOOGLE_ADMIN_EMAIL=admin@your-company.com

# ============================================================
# NextAuth
# شغّل: openssl rand -base64 32 للحصول على قيمة عشوائية
# ============================================================
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Upstash Redis (قاعدة البيانات - مجاني ويعمل مع Netlify)
# من: https://console.upstash.com → Create Database
# ============================================================
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================================
# إعدادات التطبيق
# ============================================================
# المنطقة الزمنية
NEXT_PUBLIC_TIMEZONE=Asia/Riyadh

# اسم المنظمة (يظهر في الداشبورد)
NEXT_PUBLIC_ORG_NAME=اسم شركتك

# عدد دقائق الحجز الافتراضي
NEXT_PUBLIC_DEFAULT_BOOKING_DURATION=60
